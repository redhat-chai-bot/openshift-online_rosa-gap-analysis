                <strong>Failed:</strong> {{ upgrade_e2e.summary.failed_count or 0 }} failing test(s);
                {{ upgrade_e2e.summary.degraded_operators or 0 }} degraded /
                {{ upgrade_e2e.summary.unavailable_operators or 0 }} unavailable ClusterOperator(s).
            </div>
            {% endif %}
            {% with topologies = upgrade_e2e.topologies %}
            {% include '_topology_coverage.html.j2' %}
            {% endwith %}
            <table>
                <thead><tr><th>Metric</th><th style="text-align: center;">Count</th></tr></thead>
                <tbody>
                    <tr><td>Tests</td><td style="text-align: center;">{{ upgrade_e2e.summary.tests or 0 }}</td></tr>
                    <tr><td>Failures</td><td style="text-align: center;">{{ upgrade_e2e.summary.failures or 0 }}</td></tr>
                    <tr><td>Skipped tests</td><td style="text-align: center;">{{ upgrade_e2e.summary.skipped or 0 }}</td></tr>
                    <tr><td>Degraded ClusterOperators</td><td style="text-align: center;">{{ upgrade_e2e.summary.degraded_operators or 0 }}</td></tr>
                    <tr><td>Unavailable ClusterOperators</td><td style="text-align: center;">{{ upgrade_e2e.summary.unavailable_operators or 0 }}</td></tr>
                    {% if upgrade_e2e.summary.e2e_categories %}
                    <tr><td>Workload test failures</td><td style="text-align: center;">{{ upgrade_e2e.summary.e2e_categories.workload or 0 }}</td></tr>
                    <tr><td>Storage test failures</td><td style="text-align: center;">{{ upgrade_e2e.summary.e2e_categories.storage or 0 }}</td></tr>
                    <tr><td>Network test failures</td><td style="text-align: center;">{{ upgrade_e2e.summary.e2e_categories.network or 0 }}</td></tr>
                    <tr><td>Managed operator test failures</td><td style="text-align: center;">{{ upgrade_e2e.summary.e2e_categories.managed_operator or 0 }}</td></tr>
                    {% endif %}
                    <tr><td>Duration SKIP topologies</td><td style="text-align: center;">{{ upgrade_e2e.summary.duration_skip or 0 }}</td></tr>
                    <tr><td>Pre-upgrade CO SKIP topologies</td><td style="text-align: center;">{{ upgrade_e2e.summary.pre_upgrade_skip or 0 }}</td></tr>
                    <tr><td>Post-upgrade CO FAIL topologies</td><td style="text-align: center;">{{ upgrade_e2e.summary.post_upgrade_fail or 0 }}</td></tr>
                    <tr><td>JUnit errors</td><td style="text-align: center;">{{ upgrade_e2e.summary.errors or 0 }}</td></tr>
                </tbody>
            </table>
            {% for topo in upgrade_e2e.topologies %}
            <h3>{{ topo.display_name or (topo.topology | topology_label) }}</h3>
            {% if topo.status == 'SKIP' %}
            <p><em>Skipped: {{ topo.skip_reason }}</em></p>
            {% else %}
            <p>
                {{ topo.status }} | tests {{ topo.tests }} / failures {{ topo.failures }} / skipped {{ topo.skipped }}
                {% if topo.source.gcs_url %}
                | <a href="{{ topo.source.gcs_url }}">JUnit</a>
                {% endif %}
                {% if topo.source.job_name and topo.source.job_name != 'local' %}
                | <code>{{ topo.source.job_name }}</code>
                {% endif %}
            </p>
            {% if topo.duration.status == 'SKIP' %}
            <p><em>Upgrade duration skipped: {{ topo.duration.skip_reason }}</em></p>
            {% elif topo.duration.duration %}
            <p>Upgrade duration: <code>{{ topo.duration.duration }}</code></p>
            {% endif %}
            {% if topo.pre_upgrade_operators.status == 'SKIP' %}
            <p><em>Pre-upgrade ClusterOperators skipped: {{ topo.pre_upgrade_operators.skip_reason }}</em></p>
            {% elif topo.pre_upgrade_operators.status == 'FAIL' %}
            <p><strong>Pre-upgrade ClusterOperators failed.</strong></p>
            {% elif topo.pre_upgrade_operators.cluster_version %}
            <p>Pre-upgrade ClusterOperators passed at <code>{{ topo.pre_upgrade_operators.cluster_version }}</code>.</p>
            {% endif %}
            {% set changes = topo.pre_upgrade_operators.changes or {} %}
            {% if changes.newly_degraded or changes.newly_unavailable %}
            <p>CO status changes: newly degraded {{ changes.newly_degraded|join(', ') }}; newly unavailable {{ changes.newly_unavailable|join(', ') }}</p>
            {% endif %}
            {% if topo.post_upgrade_operators.status == 'SKIP' %}
            <p><em>Post-upgrade ClusterOperators skipped: {{ topo.post_upgrade_operators.skip_reason }}</em></p>
            {% elif topo.post_upgrade_operators.status == 'FAIL' %}
            <p><strong>Post-upgrade ClusterOperators failed.</strong></p>
            {% if topo.post_upgrade_operators.degraded %}
            <p>Degraded: {% for name in topo.post_upgrade_operators.degraded %}<code>{{ name }}</code>{% if not loop.last %}, {% endif %}{% endfor %}</p>
            {% endif %}
            {% if topo.post_upgrade_operators.unavailable %}
            <p>Unavailable: {% for name in topo.post_upgrade_operators.unavailable %}<code>{{ name }}</code>{% if not loop.last %}, {% endif %}{% endfor %}</p>
            {% endif %}
            {% elif topo.post_upgrade_operators.status == 'PASS' %}
            <p>Post-upgrade ClusterOperators passed{% if topo.post_upgrade_operators.cluster_version %} at <code>{{ topo.post_upgrade_operators.cluster_version }}</code>{% endif %}.</p>
            {% endif %}
            {% if topo.failed_cases %}
            <h4>Failed post-upgrade tests</h4>
            <ul>{% for case in topo.failed_cases %}<li><code>{{ case.name }}</code>{% if case.message %} — {{ case.message }}{% endif %}</li>{% endfor %}</ul>
            {% endif %}
            {% endif %}
            {% endfor %}
            {% endif %}

            {% if feature_gates %}
            <h2 id="feature-gates">CHECK #8: Feature Gate Details (Info)</h2>

            {% if feature_gates.is_z_stream %}
            <div style="background-color: #d1ecf1; border-left: 4px solid #0c5460; padding: 15px; margin: 20px 0; border-radius: 5px;">
                <h4 style="color: #0c5460; margin-top: 0;">ℹ️ Z-Stream Comparison</h4>
                <p><strong>Baseline:</strong> {{ feature_gates.baseline }} → <strong>Target:</strong> {{ feature_gates.target }}</p>
                <p>Showing default feature gates for {{ feature_gates.version }} (z-stream updates should not change gates)</p>
            </div>

            <p><strong>Default:Hypershift gates:</strong> {{ feature_gates.default_hypershift_gates|length }}</p>
            <p><strong>Total Hypershift-relevant gates:</strong> {{ feature_gates.total_hypershift_gates }}</p>

            {% else %}
            {% set has_changes = feature_gates.comparison.added or feature_gates.comparison.removed or feature_gates.comparison.newly_enabled_by_default or feature_gates.comparison.removed_from_default %}
            {% if has_changes %}

            {% set fg_added = feature_gates.comparison.added|length %}
            {% set fg_removed = feature_gates.comparison.removed|length %}
            {% set fg_default = feature_gates.comparison.newly_enabled_by_default|length %}
            {% set fg_removed_default = feature_gates.comparison.removed_from_default|length %}
            {% set fg_total = fg_added + fg_removed + fg_default + fg_removed_default %}

            <!-- Pie Chart and Stats -->
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 30px; margin: 30px 0;">
                <div class="chart-container">
                    <canvas id="featureGatesChart"></canvas>
                </div>
                <div>
                    <h3 style="margin-top: 0;">Summary Statistics</h3>
                    <table class="stats-table">
                        <thead>
                            <tr>
                                <th>Change Type</th>
                                <th style="text-align: center;">Count</th>
                                <th style="text-align: center;">Percentage</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>New Feature Gates</td>
                                <td style="text-align: center;"><strong>{{ fg_added }}</strong></td>
                                <td style="text-align: center;">{{ "%.1f"|format((fg_added / fg_total * 100) if fg_total > 0 else 0) }}%</td>
                            </tr>
                            <tr>
                                <td>Removed Feature Gates</td>
                                <td style="text-align: center;"><strong>{{ fg_removed }}</strong></td>
                                <td style="text-align: center;">{{ "%.1f"|format((fg_removed / fg_total * 100) if fg_total > 0 else 0) }}%</td>
                            </tr>
                            <tr>
                                <td>Newly Enabled by Default</td>
                                <td style="text-align: center;"><strong>{{ fg_default }}</strong></td>
                                <td style="text-align: center;">{{ "%.1f"|format((fg_default / fg_total * 100) if fg_total > 0 else 0) }}%</td>
                            </tr>
                            {% if fg_removed_default > 0 %}
                            <tr>
                                <td>Removed from Default</td>
                                <td style="text-align: center;"><strong>{{ fg_removed_default }}</strong></td>
                                <td style="text-align: center;">{{ "%.1f"|format((fg_removed_default / fg_total * 100) if fg_total > 0 else 0) }}%</td>
                            </tr>
                            {% endif %}
                            <tr style="background-color: #f0f0f0; font-weight: bold;">
                                <td>Total Changes</td>
                                <td style="text-align: center;">{{ fg_total }}</td>
                                <td style="text-align: center;">100%</td>
                            </tr>
                            {% if feature_gates.comparison.continues_default_hypershift %}
                            <tr style="background-color: #e8f5e9;">
                                <td><strong>Continues as Default:Hypershift</strong></td>
                                <td style="text-align: center;"><strong>{{ feature_gates.comparison.continues_default_hypershift|length }}</strong></td>
                                <td style="text-align: center;"><em>Stable</em></td>
                            </tr>
                            {% endif %}
                        </tbody>
                    </table>
                </div>
            </div>

            <script>
                const ctx = document.getElementById('featureGatesChart');
                new Chart(ctx, {
                    type: 'pie',
                    data: {
                        labels: [
                            'New ({{ fg_added }})',
                            'Removed ({{ fg_removed }})',
                            'Newly Default ({{ fg_default }})'
                            {% if fg_removed_default > 0 %},'Removed from Default ({{ fg_removed_default }})'{% endif %}
                        ],
                        datasets: [{
                            data: [{{ fg_added }}, {{ fg_removed }}, {{ fg_default }}{% if fg_removed_default > 0 %}, {{ fg_removed_default }}{% endif %}],
                            backgroundColor: [
                                '#28a745',
                                '#dc3545',
                                '#ffc107'
                                {% if fg_removed_default > 0 %},'#6f42c1'{% endif %}
                            ],
                            borderWidth: 2,
                            borderColor: '#ffffff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: true,
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    padding: 15,
                                    font: {
                                        size: 12
                                    }
                                }
                            },
                            title: {
                                display: true,
                                text: 'Feature Gates Changes Distribution',
                                font: {
                                    size: 16,
                                    weight: 'bold'
                                }
                            }
                        }
                    }
                });
            </script>

            <!-- Search Box -->
            <input type="text" id="featureGateSearch" class="search-box" placeholder="🔍 Search feature gates...">

            {% if feature_gates.comparison.added %}
            <details open>
                <summary>➕ New Feature Gates ({{ fg_added }})</summary>
                <div class="content-wrapper" id="newGates">
                    {% for gate in feature_gates.comparison.added %}
                    <div class="feature-gate-item new" data-gate="{{ gate|lower }}">
                        <code>{{ gate }}</code>
                    </div>
                    {% endfor %}
                </div>
            </details>
            {% endif %}

            {% if feature_gates.comparison.newly_enabled_by_default %}
            <details>
                <summary>⭐ Newly Enabled by Default ({{ fg_default }})</summary>
                <div class="content-wrapper" id="defaultGates">
                    {% for gate in feature_gates.comparison.newly_enabled_by_default %}
                    <div class="feature-gate-item default" data-gate="{{ gate|lower }}">
                        <code>{{ gate }}</code>
                    </div>
                    {% endfor %}
                </div>
            </details>
            {% endif %}

            {% if feature_gates.comparison.removed %}
            <details>
                <summary>➖ Removed Feature Gates ({{ fg_removed }})</summary>
                <div class="content-wrapper" id="removedGates">
                    {% for gate in feature_gates.comparison.removed %}
                    <div class="feature-gate-item removed" data-gate="{{ gate|lower }}">
                        <code>{{ gate }}</code>
                    </div>
                    {% endfor %}
                </div>
            </details>
            {% endif %}

            {% if feature_gates.comparison.removed_from_default %}
            <details>
                <summary>⚠️ Removed from Default ({{ fg_removed_default }})</summary>
                <div class="content-wrapper" id="removedDefaultGates">
                    {% for gate in feature_gates.comparison.removed_from_default %}
                    <div class="feature-gate-item removed" data-gate="{{ gate|lower }}">
                        <code>{{ gate }}</code>
                    </div>
                    {% endfor %}
                </div>
            </details>
            {% endif %}

            {% if feature_gates.comparison.continues_default_hypershift %}
            {% set fg_continues = feature_gates.comparison.continues_default_hypershift|length %}
            <details>
                <summary>✓ Continues as Default:Hypershift ({{ fg_continues }})</summary>
                <div style="background-color: #e8f5e9; padding: 15px; border-left: 4px solid #4caf50; margin: 10px 0;">
                    <p><em>These feature gates remain enabled by default (Default:Hypershift) in both {{ baseline }} and {{ target }}.</em></p>
                </div>
                <div class="content-wrapper" id="continuesDefaultGates">
                    {% for gate in feature_gates.comparison.continues_default_hypershift %}
                    <div class="feature-gate-item added" data-gate="{{ gate|lower }}">
                        <code>{{ gate }}</code>
                    </div>
                    {% endfor %}
                </div>
            </details>
            {% endif %}

            <script>
                document.getElementById('featureGateSearch').addEventListener('input', function(e) {
                    const searchTerm = e.target.value.toLowerCase();
                    const items = document.querySelectorAll('.feature-gate-item');

                    items.forEach(item => {
                        const gateName = item.getAttribute('data-gate');
                        if (gateName.includes(searchTerm)) {
                            item.style.display = 'block';
                        } else {
                            item.style.display = 'none';
                        }
                    });
                });
            </script>
            {% endif %}
            {% endif %}

            {% if feature_gates.default_hypershift_gates %}
            <details>
                <summary>🛡️ Default:Hypershift Gates in {{ feature_gates.target }} ({{ feature_gates.default_hypershift_gates|length }})</summary>
                <div style="background-color: #e8f4fd; padding: 15px; border-left: 4px solid #0c5460; margin: 10px 0;">
                    <p><em>These feature gates are enabled by default with <strong>Default:Hypershift</strong> in the target version <code>{{ feature_gates.target }}</code>.</em></p>
                </div>
                <div style="margin: 10px 0;">
                    <table class="stats-table" style="width: 100%;">
                        <thead>
                            <tr>
                                <th style="text-align: left; width: 5%;">#</th>
                                <th style="text-align: left;">Feature Gate Name</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for gate in feature_gates.default_hypershift_gates %}
                            <tr>
                                <td style="text-align: left; color: #6c757d;">{{ loop.index }}</td>
                                <td><code>{{ gate }}</code></td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </details>
            {% endif %}

            {% if feature_gates.total_hypershift_gates is defined %}
            <div style="margin-top: 15px; padding: 10px 15px; background-color: #f8f9fa; border-radius: 5px; font-size: 0.95em; color: #495057;">
                <strong>Total Hypershift-relevant gates:</strong> {{ feature_gates.total_hypershift_gates }}
                &nbsp;|&nbsp;
                <strong>Default:Hypershift:</strong> {{ feature_gates.default_hypershift_gates|length }}
            </div>
            {% endif %}

            {% endif %}

            <div class="footer">
                Generated by <a href="https://github.com/openshift-online/rosa-gap-analysis" target="_blank" style="color: #007bff; text-decoration: none;">ROSA Gap Analysis</a> automation
            </div>
        </div>
    </div>
</body>
</html>
