                    <h4>{{ file_info.filename }}</h4>
                    <p><strong>Changes:</strong> {{ file_info.permissions_added_count }} added, {{ file_info.permissions_removed_count }} removed</p>
                    {% if file_info.permissions_added or file_info.permissions_removed %}
                    <ul class="permission-list">
                        {% for action in file_info.permissions_added %}
                        <li class="added">
                            <code>{{ action }}</code>
                        </li>
                        {% endfor %}
                        {% for action in file_info.permissions_removed %}
                        <li class="removed">
                            <code>{{ action }}</code>
                        </li>
                        {% endfor %}
                    </ul>
                    {% endif %}
                    {% endfor %}

                    {% if gcp_wif.validation_details and gcp_wif.validation_details.check_1_resources and gcp_wif.validation_details.check_1_resources.status == 'FAIL' %}
                    <div class="alert warning" style="margin-top: 20px;">
                        <strong>Note:</strong> managed-cluster-config validation failed. The changes shown above are expected but may be missing in managed-cluster-config.
                    </div>
                    {% endif %}
                </div>
            </details>
            {% endif %}

            {% if gcp_wif.comparison.actions.baseline_only %}
            <h3>❌ Removed Permissions ({{ gcp_wif.comparison.actions.baseline_only|length }})</h3>
            <ul class="permission-list">
                {% for action in gcp_wif.comparison.actions.baseline_only %}
                <li class="removed"><code>{{ action }}</code></li>
                {% endfor %}
            </ul>
            {% endif %}
            {% endif %}

            {% if ocp_gate_ack %}
            <h2 id="ocp-gates">CHECK #5: OCP Admin Gate Acknowledgment</h2>

            {% if ocp_gate_ack.warnings %}
            <div class="alert warning" style="background-color: #fff3cd; border-left: 4px solid #ffc107; color: #856404;">
                <h4 style="color: #856404; margin-top: 0;">⚠️ Warnings</h4>
                {% for warning in ocp_gate_ack.warnings %}
                <div style="margin-bottom: 10px;">
                    <p style="margin: 5px 0;"><strong>{{ warning.message }}</strong></p>
                    <p style="margin: 5px 0;">File: <code>{{ warning.file }}</code></p>
                    {% if warning.pr_link %}
                    <p style="margin: 5px 0;">Introduced in: <a href="{{ warning.pr_link }}" target="_blank" style="color: #0066cc; text-decoration: underline;">{{ warning.pr_link }}</a></p>
                    {% else %}
                    <p style="margin: 5px 0;">PR: Unknown</p>
                    {% endif %}
                </div>
                {% endfor %}
            </div>
            {% endif %}

            {% if ocp_gate_ack.ocm_version_gates %}
            <h3>OCM Version Gates (embedded in CHECK #5)</h3>
            <div class="alert {% if ocp_gate_ack.ocm_version_gates.status == 'PASS' %}success{% elif ocp_gate_ack.ocm_version_gates.status == 'WARN' %}warning{% else %}error{% endif %}">
                <p><strong>Status:</strong> {{ ocp_gate_ack.ocm_version_gates.status }} — {{ ocp_gate_ack.ocm_version_gates.message }}</p>
                {% if ocp_gate_ack.ocm_version_gates.gates %}
                <ul>{% for gate in ocp_gate_ack.ocm_version_gates.gates %}
                <li><code>{{ gate.id }}</code> (prefix <code>{{ gate.version_raw_id_prefix }}</code>)</li>
                {% endfor %}</ul>
                {% endif %}
            </div>
            {% endif %}

            <h3>Validation Status</h3>
            {% set minor_version = ocp_gate_ack.ack_check_version.split('.')[0] + '.' + ocp_gate_ack.ack_check_version.split('.')[1] %}
            <div class="alert {% if ocp_gate_ack.summary.gates_requiring_ack == 0 or ocp_gate_ack.validation_result == 'PASS' %}success{% else %}error{% endif %}">
                <strong>{% if ocp_gate_ack.summary.gates_requiring_ack == 0 or ocp_gate_ack.validation_result == 'PASS' %}✅ Validation Passed{% else %}❌ Validation Failed{% endif %}</strong>
                <ul style="margin: 10px 0 0 0; padding-left: 20px;">
                {% if ocp_gate_ack.summary.gates_requiring_ack == 0 %}
                    <li><strong>CHECK #5: Admin Gate Acknowledgment - PASSED</strong></li>
                    <li style="margin-left: 20px;">No admin gates found in baseline version <code>{{ baseline }}</code></li>
                    <li style="margin-left: 20px;">No acknowledgments required for version <code>{{ ocp_gate_ack.ack_check_version }}</code></li>
                {% elif ocp_gate_ack.validation_result == 'FAIL' %}
                    <li><strong>CHECK #5: Admin Gate Acknowledgment - FAILED</strong></li>
                    {% if ocp_gate_ack.summary.ack_file_missing and ocp_gate_ack.summary.gates_requiring_ack > 0 %}
                        <li style="margin-left: 20px;">Acknowledgment file missing for version {{ ocp_gate_ack.ack_check_version }}</li>
                        <li style="margin-left: 20px;">Expected location: <a href="https://github.com/openshift/managed-cluster-config/tree/master/deploy/osd-cluster-acks/ocp/{{ minor_version }}" target="_blank" style="color: #007bff; text-decoration: underline;">deploy/osd-cluster-acks/ocp/{{ minor_version }}/admin-ack.yaml or admin-gates.yaml</a></li>
                    {% endif %}
                    {% if ocp_gate_ack.summary.unacknowledged > 0 %}
                        <li style="margin-left: 20px;">{{ ocp_gate_ack.summary.unacknowledged }} gate(s) not acknowledged out of {{ ocp_gate_ack.summary.gates_requiring_ack }}</li>
                    {% endif %}
                    {% if ocp_gate_ack.structure_validation and not ocp_gate_ack.structure_validation.valid %}
                        {% for error in ocp_gate_ack.structure_validation.errors %}
                        <li style="margin-left: 20px;">Structure error: {{ error }}</li>
                        {% endfor %}
                    {% endif %}
                {% else %}
                    <li><strong>CHECK #5: Admin Gate Acknowledgment - PASSED</strong></li>
                    <li style="margin-left: 20px;">Location:
                    {% if ocp_gate_ack.structure_validation.ack_filename %}
                    <a href="https://github.com/openshift/managed-cluster-config/blob/master/deploy/osd-cluster-acks/ocp/{{ minor_version }}/{{ ocp_gate_ack.structure_validation.ack_filename }}" target="_blank" style="color: #007bff; text-decoration: underline;">deploy/osd-cluster-acks/ocp/{{ minor_version }}/{{ ocp_gate_ack.structure_validation.ack_filename }}</a>
                    {% else %}
                    <a href="https://github.com/openshift/managed-cluster-config/tree/master/deploy/osd-cluster-acks/ocp/{{ minor_version }}" target="_blank" style="color: #007bff; text-decoration: underline;">deploy/osd-cluster-acks/ocp/{{ minor_version }}</a>
                    {% endif %}
                    </li>
                    <li style="margin-left: 20px;">Validated {{ ocp_gate_ack.summary.acknowledged }} admin gate(s) acknowledged for baseline <code>{{ baseline }}</code></li>
                {% endif %}
                </ul>
            </div>

            {% if ocp_gate_ack.summary.gates_requiring_ack > 0 %}
            <h3>Admin Gates Details</h3>

            {% if ocp_gate_ack.analysis.acknowledged_gates %}
            <h3>✅ Acknowledged Gates ({{ ocp_gate_ack.analysis.acknowledged_gates|length }})</h3>
            <ul class="permission-list">
                {% for gate in ocp_gate_ack.analysis.acknowledged_gates %}
                <li class="added"><code>{{ gate }}</code></li>
                {% endfor %}
            </ul>
            {% endif %}

            {% if ocp_gate_ack.analysis.unacknowledged_gates %}
            <h3>❌ Unacknowledged Gates ({{ ocp_gate_ack.analysis.unacknowledged_gates|length }})</h3>
            <ul class="permission-list">
                {% for gate in ocp_gate_ack.analysis.unacknowledged_gates %}
                <li class="removed"><code>{{ gate }}</code></li>
                {% endfor %}
            </ul>
            {% endif %}

            {% if ocp_gate_ack.analysis.extra_acks %}
            <h3>ℹ️ Extra Acknowledgments ({{ ocp_gate_ack.analysis.extra_acks|length }})</h3>
            <ul class="permission-list">
                {% for ack in ocp_gate_ack.analysis.extra_acks %}
                <li><code>{{ ack }}</code></li>
                {% endfor %}
            </ul>
            {% endif %}
            {% endif %}
            {% endif %}

            {% if versions_channels %}
            <h2 id="versions-channels">CHECK #6: Versions & Channels</h2>

            <div class="alert {% if versions_channels.validation_result == 'FAIL' %}error{% else %}success{% endif %}">
                <strong>{% if versions_channels.validation_result == 'FAIL' %}❌ Validation FAILED{% else %}✅ Validation PASSED{% endif %}</strong>
                <ul style="margin: 10px 0 0 0; padding-left: 20px;">
                    <li><strong>Baseline {{ versions_channels.baseline }}:</strong> channels: {{ versions_channels.summary.baseline_channels|join(', ') or 'none' }}</li>
                    <li><strong>Target {{ versions_channels.target }}:</strong> highest channel: {{ versions_channels.summary.target_highest_channel }}</li>
                    <li><strong>Target GA status:</strong> {% if versions_channels.summary.target_is_ga %}GA{% else %}Pre-GA{% endif %}</li>
                </ul>
            </div>

            {% if versions_channels.validation_errors %}
            <div class="alert error">
                <strong>Validation errors</strong>
                <ul>{% for err in versions_channels.validation_errors %}<li>{{ err }}</li>{% endfor %}</ul>
            </div>
            {% endif %}
            {% if versions_channels.summary.api_errors %}
            <div class="alert warning">
                <strong>OCM API warnings</strong>
                <ul>{% for err in versions_channels.summary.api_errors %}<li>{{ err }}</li>{% endfor %}</ul>
            </div>
            {% endif %}

            <h3>Channel Availability ({{ versions_channels.target_minor }})</h3>
            <table>
                <thead>
                    <tr><th>Channel</th><th>Available</th><th>Versions</th><th>Contains Target</th></tr>
                </thead>
                <tbody>
                    {% for ch, info in versions_channels.channel_availability.target.channels.items() %}
                    <tr>
                        <td><strong>{{ ch }}-{{ versions_channels.target_minor }}</strong></td>
                        <td>{% if info.get('available') %}<span class="added">Yes</span>{% else %}<span class="removed">No</span>{% endif %}</td>
                        <td style="text-align: center;">{{ info.get('version_count', 0) }}</td>
                        <td>{% if ch in versions_channels.summary.target_channels %}<span class="added">✓</span>{% else %}✗{% endif %}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>

            <h3>Marketplace Availability</h3>

            {% if versions_channels.marketplace is defined and versions_channels.marketplace.hcp is defined %}
            <h4>ROSA HCP (via ROSA CLI)</h4>
            <table>
                <thead>
                    <tr><th>Version</th><th style="text-align: center;">HCP Available</th><th>Channels</th></tr>
                </thead>
                <tbody>
                    <tr>
                        <td><strong>Baseline:</strong> {{ versions_channels.baseline_minor }}</td>
                        <td style="text-align: center;">{% if versions_channels.marketplace.hcp.baseline.hcp_enabled %}<span class="added">✓</span>{% else %}<span class="removed">✗</span>{% endif %}</td>
                        <td>{{ versions_channels.marketplace.hcp.baseline.channels | join(', ') or '-' }}</td>
                    </tr>
                    <tr>
                        <td><strong>Target:</strong> {{ versions_channels.target_minor }}</td>
                        <td style="text-align: center;">{% if versions_channels.marketplace.hcp.target.hcp_enabled %}<span class="added">✓</span>{% else %}<span class="removed">✗</span>{% endif %}</td>
                        <td>{{ versions_channels.marketplace.hcp.target.channels | join(', ') or '-' }}</td>
                    </tr>
                </tbody>
            </table>
            {% endif %}

            {% if versions_channels.marketplace is defined and versions_channels.marketplace.available %}
            {% set mp = versions_channels.marketplace %}
            {% set mp_versions = mp.aws.target_minor_versions %}

            <h4>ROSA Classic (via OCM API)</h4>

            {# ─── Build per-channel summary ─── #}
            {% set ns = namespace(channels={}) %}
            {% for v in mp_versions %}
            {% set ch = v.channel_group %}
            {% if ch not in ns.channels %}
            {% set _ = ns.channels.update({ch: {'rosa_classic': 0, 'rosa_hcp': 0, 'total': 0, 'latest': v.version}}) %}
            {% endif %}
            {% set _ = ns.channels[ch].update({'total': ns.channels[ch].total + 1}) %}
            {% if v.version > ns.channels[ch].latest %}
            {% set _ = ns.channels[ch].update({'latest': v.version}) %}
            {% endif %}
            {% if v.rosa_enabled %}
            {% set _ = ns.channels[ch].update({'rosa_classic': ns.channels[ch].rosa_classic + 1}) %}
            {% endif %}
            {% if v.hosted_control_plane_enabled %}
            {% set _ = ns.channels[ch].update({'rosa_hcp': ns.channels[ch].rosa_hcp + 1}) %}
            {% endif %}
            {% endfor %}

            {# ─── Build per-channel latest version for ROSA Classic (strip channel suffix) ─── #}
            {% set ns2 = namespace(classic={}) %}
            {% for v in mp_versions %}
            {% set ch = v.channel_group %}
            {% set clean_ver = v.version.replace('-' ~ ch, '') %}
            {% if v.rosa_enabled %}
            {% if ch not in ns2.classic or clean_ver > ns2.classic[ch] %}
            {% set _ = ns2.classic.update({ch: clean_ver}) %}
            {% endif %}
            {% endif %}
            {% endfor %}

            <table>
                <thead>
                    <tr>
                        <th>Channel</th>
                        <th style="text-align: center;">ROSA Classic</th>
                    </tr>
                </thead>
                <tbody>
                    {% for ch in ns.channels %}
                    <tr>
                        <td><strong>{{ ch }}</strong></td>
                        <td style="text-align: center;">{% if ch in ns2.classic %}<span class="added">✓</span> <span style="font-family: monospace; font-size: 0.9em;">{{ ns2.classic[ch] }}</span>{% else %}<span class="removed">✗</span> —{% endif %}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>

            {% if not versions_channels.summary.gcp_skipped %}
            {# ─── Build per-channel latest version for OSD GCP (strip channel suffix) ─── #}
            {% set ns3 = namespace(gcp={}) %}
            {% for v in mp.gcp.target_minor_versions %}
            {% set ch = v.channel_group %}
            {% if v.gcp_marketplace_enabled %}
            {% set clean_ver = v.version.replace('-' ~ ch, '') %}
            {% if ch not in ns3.gcp or clean_ver > ns3.gcp[ch] %}
            {% set _ = ns3.gcp.update({ch: clean_ver}) %}
            {% endif %}
            {% endif %}
            {% endfor %}

            <h4>OSD GCP Marketplace Enablement</h4>
            <table>
                <thead>
                    <tr>
                        <th>Channel</th>
                        <th style="text-align: center;">OSD GCP</th>
                    </tr>
                </thead>
                <tbody>
                    {% for ch in ns.channels %}
                    <tr>
                        <td><strong>{{ ch }}</strong></td>
                        <td style="text-align: center;">{% if ch in ns3.gcp %}<span class="added">✓</span> <span style="font-family: monospace; font-size: 0.9em;">{{ ns3.gcp[ch] }}</span>{% else %}<span class="removed">✗</span> —{% endif %}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            {% else %}
            <h4>OSD GCP Marketplace Enablement</h4>
            <p><em>Skipped — 5.x is AWS/STS-only, OSD GCP not applicable</em></p>
            {% endif %}

            <details>
                <summary>Baseline / Target Version Details</summary>
                <div class="content-wrapper">
                <table>
                    <thead>
                        <tr><th>Version</th><th style="text-align: center;">ROSA Classic</th>{% if not versions_channels.summary.gcp_skipped %}<th style="text-align: center;">OSD GCP</th>{% endif %}<th>Channel</th></tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><strong>Baseline:</strong> {{ versions_channels.baseline }}</td>
                            <td style="text-align: center;">{% if mp.aws.baseline.rosa_enabled is none %}—{% elif mp.aws.baseline.rosa_enabled %}<span class="added">✓</span>{% else %}<span class="removed">✗</span>{% endif %}</td>
                            {% if not versions_channels.summary.gcp_skipped %}
                            <td style="text-align: center;">{% if mp.gcp.baseline.skipped %}⊘ skipped{% elif mp.gcp.baseline.gcp_marketplace_enabled is none %}—{% elif mp.gcp.baseline.gcp_marketplace_enabled %}<span class="added">✓</span>{% else %}<span class="removed">✗</span>{% endif %}</td>
                            {% endif %}
                            <td>{{ mp.aws.baseline.channel_group or '-' }}</td>
                        </tr>
                        <tr>
                            <td><strong>Target:</strong> {{ versions_channels.target }}</td>
                            <td style="text-align: center;">{% if mp.aws.target.rosa_enabled is none %}—{% elif mp.aws.target.rosa_enabled %}<span class="added">✓</span>{% else %}<span class="removed">✗</span>{% endif %}</td>
                            {% if not versions_channels.summary.gcp_skipped %}
                            <td style="text-align: center;">{% if mp.gcp.target.skipped %}⊘ skipped{% elif mp.gcp.target.gcp_marketplace_enabled is none %}—{% elif mp.gcp.target.gcp_marketplace_enabled %}<span class="added">✓</span>{% else %}<span class="removed">✗</span>{% endif %}</td>
                            {% endif %}
                            <td>{{ mp.aws.target.channel_group or '-' }}</td>
                        </tr>
                    </tbody>
                </table>
                </div>
            </details>
            {% elif versions_channels.marketplace is defined and not versions_channels.marketplace.available %}
            <p><em>ROSA Classic skipped — OCM not authenticated</em></p>
            {% endif %}

            {% endif %}

            {% if ocm_version_gate %}
            <h2 id="ocm-version-gates">CHECK #7: OCM Version Gate Details</h2>

            {% if ocm_version_gate.is_mock_data %}
            <div style="background-color: #fff3cd; border-left: 4px solid #ffc107; padding: 15px; margin: 20px 0; border-radius: 5px;">
                <h4 style="color: #856404; margin-top: 0;">⚠️ Mock/Simulated Data Mode</h4>
                <p>This report was generated using simulated OCM data because no OCM token or CLI authentication was detected.</p>
            </div>
            {% endif %}

            {% if not ocm_version_gate.configuration_validation.valid %}
            <div style="background-color: #f8d7da; border-left: 4px solid #dc3545; padding: 15px; margin: 20px 0; border-radius: 5px;">
                <h4 style="color: #721c24; margin-top: 0;">❌ Configuration Validation Errors</h4>
                <ul style="margin: 0; padding-left: 20px; color: #721c24;">
                    {% for error in ocm_version_gate.configuration_validation.errors %}
                    <li>{{ error }}</li>
                    {% endfor %}
                </ul>
            </div>
            {% endif %}

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 25px;">
                <div style="background-color: #f8f9fa; border: 1px solid #e9ecef; padding: 15px; border-radius: 5px;">
                    <h4 style="margin-top: 0; color: #495057;">Active Gates Summary</h4>
                    <p style="margin: 5px 0;"><strong>Baseline Version:</strong> <code>{{ ocm_version_gate.baseline_minor }}</code></p>
                    <p style="margin: 5px 0;"><strong>Baseline Gates Count:</strong> <span class="badge {% if ocm_version_gate.gates_count.baseline > 0 %}success{% else %}warning{% endif %}" style="padding: 2px 8px; border-radius: 3px; font-weight: bold;">{{ ocm_version_gate.gates_count.baseline }}</span></p>
                    <p style="margin: 5px 0;"><strong>Target Version:</strong> <code>{{ ocm_version_gate.target_minor }}</code></p>
                    <p style="margin: 5px 0;"><strong>Target Gates Count:</strong> <span class="badge {% if ocm_version_gate.gates_count.target > 0 %}success{% else %}error{% endif %}" style="padding: 2px 8px; border-radius: 3px; font-weight: bold;">{{ ocm_version_gate.gates_count.target }}</span></p>
                </div>
                <div style="background-color: #f8f9fa; border: 1px solid #e9ecef; padding: 15px; border-radius: 5px;">
                    <h4 style="margin-top: 0; color: #495057;">Gate Comparison (by label)</h4>
                    <p style="margin: 5px 0;"><strong>Common Gates:</strong> <span style="font-weight: bold; color: #28a745;">{{ ocm_version_gate.comparison.common_gates_count }}</span></p>
                    <p style="margin: 5px 0;"><strong>New Gates (Target Only):</strong> <span style="font-weight: bold; color: #007bff;">{{ ocm_version_gate.comparison.new_gates_count }}</span></p>
                    <p style="margin: 5px 0;"><strong>Removed Gates (Baseline Only):</strong> <span style="font-weight: bold; color: #dc3545;">{{ ocm_version_gate.comparison.deprecated_gates_count }}</span></p>
                </div>
            </div>

            {% if ocm_version_gate.comparison.new_gates %}
            <h3>New Gates (target only)</h3>
            <ul>{% for gate in ocm_version_gate.comparison.new_gates %}<li><code>{{ gate.label if gate.label is defined else gate }}</code>{% if gate.description is defined %} — {{ gate.description }}{% endif %}</li>{% endfor %}</ul>
            {% endif %}
            {% if ocm_version_gate.comparison.deprecated_gates %}
            <h3>Removed Gates (baseline only)</h3>
            <ul>{% for gate in ocm_version_gate.comparison.deprecated_gates %}<li><code>{{ gate.label if gate.label is defined else gate }}</code>{% if gate.description is defined %} — {{ gate.description }}{% endif %}</li>{% endfor %}</ul>
            {% endif %}
            {% if ocm_version_gate.skipped_labels %}
            <div class="alert warning"><strong>Skipped gate labels:</strong> {% for label in ocm_version_gate.skipped_labels %}<code>{{ label }}</code>{% if not loop.last %}, {% endif %}{% endfor %}</div>
            {% endif %}

            <!-- Target Gates Details -->
            <h3>Target Version Gates ({{ ocm_version_gate.target_minor }}.x)</h3>
            {% if ocm_version_gate.gates_count.target > 0 %}
                {% for gate in ocm_version_gate.target_gates %}
                <div style="border: 1px solid #dee2e6; border-radius: 6px; padding: 15px; margin-bottom: 15px; background-color: #fff;">
                    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #e9ecef; padding-bottom: 8px; margin-bottom: 10px;">
                        <span style="font-family: monospace; font-weight: bold; background-color: #f1f3f5; padding: 2px 6px; border-radius: 4px;">{{ gate.label }}</span>
                        <span style="font-size: 0.85em; color: #6c757d; font-family: monospace;">ID: {{ gate.id }}</span>
                    </div>
                    <div style="font-size: 1.05em; font-weight: 500; margin-bottom: 10px;">{{ gate.description }}</div>
                    <div style="display: flex; flex-wrap: wrap; gap: 10px; font-size: 0.9em; color: #495057; margin-bottom: 10px;">
                        <span style="background-color: #e9ecef; padding: 2px 8px; border-radius: 4px;">Value: {{ gate.value }}</span>
                        <span style="background-color: #e9ecef; padding: 2px 8px; border-radius: 4px;">Prefix: {{ gate.version_raw_id_prefix }}</span>
                        {% if gate.sts_only %}
                        <span style="background-color: #cff4fc; color: #055160; padding: 2px 8px; border-radius: 4px; font-weight: 500;">STS Only</span>
                        {% else %}
                        <span style="background-color: #e2e3e5; padding: 2px 8px; border-radius: 4px;">All Clusters (Non-STS &amp; STS)</span>
                        {% endif %}
                        {% if gate.documentation_url %}
                        <a href="{{ gate.documentation_url }}" target="_blank" style="background-color: #e8f0fe; color: #1a73e8; padding: 2px 8px; border-radius: 4px; text-decoration: none; font-weight: 500;">Docs ↗</a>
                        {% endif %}
                    </div>
                    {% if gate.warning_message %}
                    <div style="background-color: #fdf2f2; border-left: 3px solid #dc3545; padding: 10px; border-radius: 4px; font-size: 0.95em; color: #a12020;">
                        <strong>Warning:</strong> {{ gate.warning_message }}
                    </div>
                    {% endif %}
                </div>
                {% endfor %}
            {% else %}
                <div style="background-color: #fdf2f2; border: 1px solid #f5c2c2; padding: 15px; border-radius: 5px; color: #721c24; margin-bottom: 25px;">
                    <strong>Missing Target Version Gates:</strong> No version gates are active for target minor version prefix <code>{{ ocm_version_gate.target_minor }}</code> in OCM.
                </div>
            {% endif %}

            <!-- Baseline Gates Details -->
            <h3>Baseline Version Gates ({{ ocm_version_gate.baseline_minor }}.x)</h3>
            {% if ocm_version_gate.gates_count.baseline > 0 %}
                {% for gate in ocm_version_gate.baseline_gates %}
                <div style="border: 1px solid #dee2e6; border-radius: 6px; padding: 15px; margin-bottom: 15px; background-color: #fdfdfd; opacity: 0.85;">
                    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #e9ecef; padding-bottom: 8px; margin-bottom: 10px;">
                        <span style="font-family: monospace; font-weight: bold; background-color: #e9ecef; padding: 2px 6px; border-radius: 4px;">{{ gate.label }}</span>
